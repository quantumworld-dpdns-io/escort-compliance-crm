root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,vue}]
indent_style = space
indent_size = 2

[*.{rs}]
indent_style = space
indent_size = 4

[*.{jl}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 4

[*.robot]
indent_style = space
indent_size = 2
