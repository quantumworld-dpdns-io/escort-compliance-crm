# Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgres://user:password@alwaysdata-host:5432/escort_crm
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BROKERS=localhost:9092

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# PQC
PQC_ENABLED=true
PQC_ALGORITHM=kyber768
QRNG_ENABLED=false

# Quantum Optimization
QUANTUM_OPT_ENABLED=true
QUANTUM_OPT_BACKEND=simulator

# Quantum ML
QUANTUM_ML_ENABLED=true
QUANTUM_ML_BACKEND=simulator

# ML/AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB
CHROMA_HOST=localhost
CHROMA_PORT=8000
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Security
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WAF_ENABLED=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Deployment
DEPLOY_ENV=development
CHOREO_PROJECT_ID=
K8S_NAMESPACE=escort-crm
